# Copier ce fichier en .env et remplir les valeurs
# ── Base de données MySQL ─────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Connexion SQLAlchemy ──────────────────────────────────────────
DATABASE_URL=mysql+pymysql://USER:PASSWORD@db:3306/DB_NAME

# ── Authentification JWT ──────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15